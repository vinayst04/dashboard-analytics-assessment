# PostgreSQL connection string from Aiven, Neon, Supabase, or another provider.
DATABASE_URL=postgresql+psycopg://username:password@host:port/database?sslmode=require

# Used to sign dashboard authentication tokens. Generate a long random value.
JWT_SECRET=replace-with-a-long-random-secret

# Google OAuth credentials for "Continue with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
APP_BASE_URL=http://127.0.0.1:5173

# Optional: enables the AI insights panel using Gemini's free tier.
GEMINI_API_KEY=

# Allows the local Vite client to call FastAPI during development.
FRONTEND_ORIGIN=http://localhost:5173
